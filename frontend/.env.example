# ──────────────────────────────────────────────────────────────────────────────
# MediGrid Frontend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file (it is already in .gitignore).
# All variables MUST start with VITE_ to be accessible in the browser.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Development: http://localhost:5000
# Production:  https://your-backend-api-domain.com
VITE_BACKEND_URL=http://localhost:5000

# ── Google AI (Gemini) ────────────────────────────────────────────────────────
# Used for client-side AI requests from Dashboard.
# Create at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSy...

# ── Razorpay (Public Key Only) ────────────────────────────────────────────────
# Only the KEY_ID is safe for the browser. The KEY_SECRET stays on the backend.
# Create at: https://dashboard.razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_...

# ── Google OAuth (Client ID only) ─────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── GitHub OAuth (Client ID only) ─────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
VITE_GITHUB_CLIENT_ID=Ov23li...

# ── Microsoft OAuth (Client ID only) ──────────────────────────────────────────
# Register at: https://portal.azure.com → App registrations
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id
