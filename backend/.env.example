# ──────────────────────────────────────────────────────────────────────────────
# MediGrid Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file (it is already in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:5173
# Production:  https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local MongoDB URI)
# Create at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/?appName=Cluster0

# ── Authentication ────────────────────────────────────────────────────────────
# A long, random, secret string used to sign JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# ── Google AI (Gemini) ────────────────────────────────────────────────────────
# Create at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Create at: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Set Authorized redirect URI: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
# Set callback URL: http://localhost:5173
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Microsoft OAuth (Azure) ───────────────────────────────────────────────────
# Register at: https://portal.azure.com → App registrations
# Set redirect URI: http://localhost:5173
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# ── Email (SMTP via Gmail) ────────────────────────────────────────────────────
# Use a Gmail App Password (not your regular password).
# Enable at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_16_chars

# ── Cloudinary (Profile Photo Upload) ────────────────────────────────────────
# Create at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
